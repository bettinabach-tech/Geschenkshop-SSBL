---
// Interne Übersicht aller Seiten der Fabrik. Nicht für Suchmaschinen gedacht.
import { getSites } from "../lib/sites";

const sites = getSites();
---

<!doctype html>
<html lang="de">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>Übersicht – landingpage-fabrik</title>
  </head>
  <body>
    <main>
      <h1>Übersicht der Seiten</h1>
      <ul>
        {sites.map((site) => (
          <li>
            <a href={`/${site.slug}/`}>{site.titel}</a>
          </li>
        ))}
      </ul>
    </main>
  </body>
</html>
