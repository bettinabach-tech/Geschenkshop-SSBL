---
// Musterseite der Bausteine — NUR in der Vorschau (npm run dev) unter /muster/.
// Beim Bauen liefert getStaticPaths nichts, die Seite wird nie veröffentlicht.
// Zweck: Sichtprüfung der ganzen Landingpage (Kopf, Hero, Nutzen, Vertrauen,
// Kauf-Bereich, Footer), bevor die echte Seite (Aufgabe 015) sie verwendet.
// Texte sind Muster, nicht endgültig.
import Bild from "../components/Bild.astro";
import Hero from "../components/Hero.astro";
import KaufBereich from "../components/KaufBereich.astro";
import Landingpage from "../components/Landingpage.astro";
import Nutzen from "../components/Nutzen.astro";
import Vertrauen from "../components/Vertrauen.astro";
import { getSite } from "../lib/sites";
import Bestellformular from "../sites/geschenkshop-ssbl/Bestellformular.astro";
import Produktkarten from "../sites/geschenkshop-ssbl/Produktkarten.astro";
import { pruefeProdukte } from "../sites/geschenkshop-ssbl/produkte";

export function getStaticPaths() {
  return import.meta.env.DEV ? [{ params: { muster: "muster" } }] : [];
}

const site = getSite("geschenkshop-ssbl");

// BEISPIELWERTE nur für die Sichtprüfung der Kartenzustände — keine echten
// Preise. Die echten stehen in produkte.yaml (Aufgabe 026).
const beispielProdukte = pruefeProdukte([
  {
    id: "beispiel-bestellbar",
    name: "Beispiel: bestellbar",
    foto: "assets/products/keramik-schalen-set.jpg",
    alt: "Drei Keramikschalen in Rosa, Blau und Rot mit eingeritzten Mustern",
    beschreibung: "Beispieltext für eine Beschreibung (kommt mit Aufgabe 014).",
    preis: 24.5,
    stueck: 3,
  },
  {
    id: "beispiel-ausverkauft",
    name: "Beispiel: ausverkauft",
    foto: "assets/products/anzuendholz-buendel.jpg",
    alt: "Bündel aus hellem, gespaltenem Anzündholz, mit Hanfschnur zusammengebunden",
    preis: 12,
    stueck: 0,
  },
  {
    id: "beispiel-wein",
    name: "Beispiel: Wein, Preis folgt",
    foto: "assets/products/klosterwein-divico.jpg",
    alt: "Weinflasche «Klosterwein Rathausen Divico 2023», die Etikette zeigt eine gemalte blaue Traube",
    wein: true,
  },
  {
    // Zeigt das Häkchen «mindestens 16» im Bestellformular (Aufgabe 020).
    id: "beispiel-wein-bestellbar",
    name: "Beispiel: Wein, bestellbar",
    foto: "assets/products/klosterwein-souvignier-gris.jpg",
    alt: "Weinflasche «Klosterwein Rathausen Souvignier Gris 2023», die Etikette zeigt eine gemalte Kirche über Rebbergen",
    preis: 18,
    stueck: 6,
    wein: true,
  },
]);
---

<Landingpage site={site}>
  <Hero
    slot="hero"
    ueberschrift="Sinnvolle Geschenke aus den Werkstätten der SSBL"
    unterzeile="Bestellen Sie bis 15.12.2026 und holen Sie im Lädeli ab oder lassen Sie liefern."
    ctaText="Jetzt bestellen"
    ctaHref="#bestellen"
  >
    <p>
      <strong>Musterseite (nur Vorschau):</strong> Texte sind Muster, die echten
      folgen mit Aufgabe 015. Im Footer fehlen Impressum und Datenschutz, bis
      die Links geliefert sind (Aufgabe 023).
    </p>
    <Bild
      slot="bild"
      src="assets/products/keramik-schalen-set.jpg"
      alt="Drei Keramikschalen in Rosa, Blau und Rot mit eingeritzten Mustern"
      sizes="(min-width: 48rem) 40rem, 100vw"
      loading="eager"
    />
  </Hero>
  <Nutzen
    slot="nutzen"
    ueberschrift="Warum ein Geschenk aus der SSBL"
    punkte={[
      {
        titel: "Gutes tun",
        text: "Mit Ihrem Kauf unterstützen Sie die SSBL.",
      },
      {
        titel: "Sinnvoll schenken",
        text: "Sie finden ein sinnvolles Geschenk, ohne stundenlang zu suchen.",
      },
      {
        titel: "Mit echter Geschichte",
        text: "Jedes Geschenk hat eine Geschichte statt etwas Beliebigem.",
      },
    ]}
  />
  <Vertrauen slot="vertrauen" titel="Die SSBL">
    <p>
      Die SSBL – Stiftung für selbstbestimmtes und begleitetes Leben – hat ihren
      Hauptsitz in Rathausen (Emmen) und neun weitere Standorte. Sie bietet bis
      zu 305 Wohnplätze und 80 Arbeitsplätze für Tagesbeschäftigte.
    </p>
    <p>
      (Muster: Hier folgt die Geschichte der Werkstätten mit echtem Foto,
      Aufgabe 025.)
    </p>
    <Bild
      slot="bild"
      src="assets/products/anzuendholz-buendel.jpg"
      alt="Bündel aus hellem, gespaltenem Anzündholz, mit Hanfschnur zusammengebunden"
      sizes="(min-width: 48rem) 40rem, 100vw"
    />
  </Vertrauen>
  <KaufBereich slot="kauf" ueberschrift="Jetzt bestellen">
    <p>
      (Muster: Kartenzustände mit Beispielwerten — keine echten Preise. Das
      echte Bestellformular (Aufgabe 019) ist unten; Adresse und Alter folgen
      mit 020. Da es noch keinen Empfänger gibt, zeigt «Bestellung absenden»
      hier immer den Hinweis für technische Fehler.)
    </p>
    <Produktkarten produkte={beispielProdukte} formular="bestellung" />
    <Bestellformular slot="aktion" site={site} produkte={beispielProdukte} />
  </KaufBereich>
</Landingpage>
