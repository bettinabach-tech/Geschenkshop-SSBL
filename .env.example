# Vorlage für geheime Werte. Echte Werte kommen in .env (nie ins Projekt,
# steht in .gitignore) bzw. in die Einstellungen beim Hosting-Anbieter.
# Welche Variablen es gibt, legt Aufgabe 008 (Formular-Empfänger) fest; die
# Werte liefert die IT der SSBL, sobald sie Anbieter und Mailserver bestimmt hat.

# Mailserver, über den Bestellungen verschickt werden (von der SSBL-IT)
SMTP_HOST=
# Port des Mailservers, meist 587 (von der SSBL-IT)
SMTP_PORT=
# Benutzername für den Mailserver (von der SSBL-IT)
SMTP_USER=
# Passwort für den Mailserver (von der SSBL-IT — nie in Chat oder Datei im Projekt)
SMTP_PASS=
# Absenderadresse der Mails, z.B. laedeli@ssbl.ch (von der SSBL-IT freigegeben)
MAIL_FROM=
